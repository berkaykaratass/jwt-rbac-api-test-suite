{
  "name": "jwt-rbac-api-test-suite",
  "version": "1.0.0",
  "description": "Professional automated testing suite for a JWT & RBAC-based REST API",
  "author": "Berkay Karataş",
  "license": "MIT",
  "scripts": {
    "test": "npx playwright test",
    "test:setup": "npx ts-node src/setup/seed.ts",
    "test:auth": "npx playwright test src/tests/auth/",
    "test:rbac": "npx playwright test src/tests/rbac/",
    "test:tutorials": "npx playwright test src/tests/tutorials/",
    "test:e2e": "npx playwright test src/tests/e2e/",
    "test:security": "npx playwright test src/tests/security/",
    "test:report": "npx playwright show-report",
    "test:headed": "npx playwright test --headed",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down -v",
    "docker:logs": "docker compose logs -f app",
    "setup": "npm run docker:up && sleep 10 && npm run test:setup",
    "ci": "npm run setup && npm test"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "ts-node": "^10.9.2"
  },
  "dependencies": {
    "mongodb": "^6.12.0",
    "dotenv": "^16.4.7"
  }
}
